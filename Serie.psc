Algoritmo Serie
	
	Definir cantidadTerminos, contadorNumeros, termino Como Entero
	
	Escribir "Ingrese la cantidad de terminos a generar: "
	Leer cantidadTerminos
	
	termino <- 1
	
	Para contadorNumeros <- 1 Hasta cantidadTerminos - 1 Hacer
	
	Escribir Sin Saltar termino, ", "
	
	termino <- termino + 2
	
	FinPara
	
	Escribir termino
	
FinAlgoritmo

