Algoritmo Tabla
	
    Definir cantidadNumeros, numero1 Como Entero
	
    Escribir "Ingrese la cantidad de numeros: "
	
    Repetir
	Leer cantidadNumeros
    
    Hasta Que cantidadNumeros >= 0
	

    Para numero1 <- 1 Hasta cantidadNumeros Hacer
	
	Escribir Sin Saltar numero1, " "
	Escribir Sin Saltar numero1 * numero1, " "
    Escribir numero1 + numero1 * numero1
    
    FinPara
	
FinAlgoritmo